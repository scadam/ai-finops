# Copy to .env and fill in values for local development.
# In Azure, all secrets are loaded from Key Vault via Managed Identity.

# --- App ---
AI_FINOPS_ENV=dev
AI_FINOPS_LOG_LEVEL=INFO
AI_FINOPS_RATE_CARD_DIR=./config/rate_cards
AI_FINOPS_RATE_CARD_REFRESH_MINUTES=60
AI_FINOPS_RATE_CARD_STALE_DAYS=7
AI_FINOPS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Auth (Entra ID) — leave blank in dev to disable auth ---
AI_FINOPS_TENANT_ID=
AI_FINOPS_CLIENT_ID=
AI_FINOPS_API_AUDIENCE=api://ai-finops

# --- Database (Azure SQL) ---
AI_FINOPS_DATABASE_URL=

# --- Azure integration ---
AI_FINOPS_AZURE_SUBSCRIPTION_ID=
AI_FINOPS_FOCUS_STORAGE_ACCOUNT=
AI_FINOPS_FOCUS_CONTAINER=focus-exports
