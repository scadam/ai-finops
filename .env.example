# Copy to .env and fill in values for local development.
# In Azure, all secrets are loaded from Key Vault via Managed Identity.

# --- App ---
AI_FINOPS_ENV=dev
AI_FINOPS_LOG_LEVEL=INFO
AI_FINOPS_RATE_CARD_DIR=./config/rate_cards
AI_FINOPS_RATE_CARD_REFRESH_MINUTES=60
AI_FINOPS_RATE_CARD_STALE_DAYS=7
AI_FINOPS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Auth (Entra ID) — leave blank in dev to disable auth ---
AI_FINOPS_TENANT_ID=
AI_FINOPS_CLIENT_ID=
AI_FINOPS_API_AUDIENCE=api://ai-finops

# --- Database (Azure SQL) ---
AI_FINOPS_DATABASE_URL=

# --- Azure integration ---
AI_FINOPS_AZURE_SUBSCRIPTION_ID=
AI_FINOPS_FOCUS_STORAGE_ACCOUNT=
AI_FINOPS_FOCUS_CONTAINER=focus-exports

# --- Microsoft SDK auth (used by every plug-and-play puller) ---
# Every puller authenticates via DefaultAzureCredential, which picks up:
#   * Managed Identity in App Service / Functions
#   * Workload Identity Federation in CI (GitHub OIDC)
#   * `az login` device-code flow locally
# AZURE_TENANT_ID is required outside Azure-hosted environments.
# AZURE_CLIENT_ID selects a User-Assigned MI when more than one is attached.
AI_FINOPS_AZURE_TENANT_ID=
AI_FINOPS_AZURE_CLIENT_ID=
AI_FINOPS_AZURE_CLIENT_SECRET=
AI_FINOPS_PURVIEW_ACCOUNT_ENDPOINT=

# --- Plug-and-play feature-flag matrix (default OFF) ---
# Enable a source only AFTER granting the matching app-role / RBAC.
# See docs/permissions.md for the exact role each flag requires.
AI_FINOPS_INGEST_AGENT365_ENABLED=false
AI_FINOPS_INGEST_ENTRA_DIRECTORY_ENABLED=false
AI_FINOPS_INGEST_ENTRA_LICENSING_ENABLED=false
AI_FINOPS_INGEST_PURVIEW_ENABLED=false
AI_FINOPS_INGEST_DEFENDER_ENABLED=false
AI_FINOPS_INGEST_POWER_PLATFORM_ENABLED=false
AI_FINOPS_INGEST_AZURE_INVENTORY_ENABLED=false
AI_FINOPS_INGEST_COST_MANAGEMENT_ENABLED=false
AI_FINOPS_INGEST_GRAPH_CREDITS_ENABLED=false
AI_FINOPS_INGEST_GRAPH_LICENSES_ENABLED=false

# --- Modeller ---
AI_FINOPS_MODELER_CONFIG_DIR=./config/modeler
